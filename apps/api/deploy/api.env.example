# EXAMPLE ONLY. Install actual configuration outside Git at /etc/kape-sa-likod/api.env.
# Actual file must be readable only by root and the dedicated service identity.
NODE_ENV=production
PORT=3100
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=kape_sa_likod
PGUSER=kape_sa_likod_app
# PGPASSWORD must be entered privately in the actual file after separate approval.
ALLOWED_ORIGINS=https://kapesalikod.pages.dev
UPLOAD_DIR=/var/lib/kape-sa-likod/uploads
